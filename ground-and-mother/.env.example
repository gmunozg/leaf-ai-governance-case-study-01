# Public — safe for the browser
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Server-only — never prefix these with NEXT_PUBLIC_
# Long random string. Add it to your Gumroad Ping URL as ?secret=... (Settings → Advanced → Ping).
GUMROAD_PING_SECRET=
# Gumroad OAuth access token, used server-side to confirm sales and verify license keys.
GUMROAD_ACCESS_TOKEN=
